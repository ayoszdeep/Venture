PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/waygood-evaluation
JWT_SECRET=replace-with-a-long-secret
JWT_EXPIRES_IN=1d
CACHE_TTL_SECONDS=300

# Optional: set to share the cache across replicas instead of the in-memory Map.
REDIS_URL=

# Optional: enables the AI study-plan endpoint (GET /api/ai/study-plan/:studentId).
# Without a key the endpoint still works and serves a deterministic rule-based plan.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
